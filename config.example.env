# Copy to lira.env (or export these) before running.

# Address to listen on.
LIRA_ADDR=:8080

# Path to the SQLite database file (created on first run).
LIRA_DB=./lira.db

# Keep true in production (behind HTTPS / a Cloudflare tunnel).
# Set false ONLY for plain-HTTP local testing, or the session cookie won't be sent.
LIRA_SECURE_COOKIES=true

# Hard cap on total accounts (default: 2 household members). Applies to the admin plus
# any invited members. The public /register page only creates the FIRST account
# (the admin) and then closes; everyone else joins via an admin-issued invite.
LIRA_MAX_USERS=2

# Public origin used to build absolute invite links (no trailing slash), e.g.
# https://lira.example.com. Leave empty to derive it from the request host.
LIRA_BASE_URL=

# Session lifetime in hours (default 7 days).
LIRA_SESSION_TTL_HOURS=168

# Label shown in your authenticator app.
LIRA_ISSUER=Lira

# Twelve Data API key — enables auto-fetching holding prices and EUR FX rates.
# Free key at twelvedata.com (800 req/day is plenty). Empty = feature off; NAV
# then treats every currency as EUR until rates are fetched.
LIRA_MARKET_API_KEY=

# How often the background fetcher refreshes prices + FX (hours).
LIRA_FETCH_INTERVAL_HOURS=24
